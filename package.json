{
  "name": "anatha-stores-pos",
  "version": "1.0.0",
  "description": "ANATHA STORES — Professional Supermarket Desktop Billing and Management System",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:server": "node server/index.js",
    "backend": "node server/index.js",
    "frontend": "vite",
    "dev:web": "concurrently --kill-others-on-fail -p \"[{name}]\" -n \"SERVER,VITE\" -c \"green.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev:vite\"",
    "dev:electron": "wait-on http://localhost:5173 http://localhost:5000/api/health && electron .",
    "dev": "concurrently --kill-others-on-fail -p \"[{name}]\" -n \"SERVER,VITE\" -c \"green.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev:vite\"",
    "dev:desktop": "concurrently --kill-others-on-fail -p \"[{name}]\" -n \"VITE,SERVER,APP\" -c \"cyan.bold,green.bold,magenta.bold\" \"npm run dev:vite\" \"npm run dev:server\" \"npm run dev:electron\"",
    "dev:app": "concurrently --kill-others-on-fail -p \"[{name}]\" -n \"VITE,SERVER,APP\" -c \"cyan.bold,green.bold,magenta.bold\" \"npm run dev:vite\" \"npm run dev:server\" \"npm run dev:electron\"",
    "start": "npm run dev:web",
    "server": "npm run dev:server",
    "health": "powershell -Command \"Invoke-RestMethod http://localhost:5000/api/health | ConvertTo-Json -Depth 5\"",
    "kill:port": "powershell -Command \"Get-NetTCPConnection -LocalPort 5000,5173 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\"",
    "build:vite": "vite build",
    "build:electron": "electron-builder",
    "prisma:generate": "prisma generate --schema=./server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./server/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./server/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./server/prisma/schema.prisma",
    "test": "node test_complete_pos.js && node test_100_products_and_branding.js && node test_receipt_specifications.js && node test_weight_billing_system.js && node test_print_and_portal.js && node test_logo_and_watermark.js && node test_pos_upgrade_suite.js && node test_ai_assistant_suite.js",
    "test:pos": "node test_complete_pos.js",
    "test:branding": "node test_100_products_and_branding.js",
    "test:receipt": "node test_receipt_specifications.js",
    "test:weight": "node test_weight_billing_system.js",
    "test:print": "node test_print_and_portal.js",
    "test:logo": "node test_logo_and_watermark.js",
    "test:upgrade": "node test_pos_upgrade_suite.js",
    "test:ai": "node test_ai_assistant_suite.js"
  },
  "keywords": [
    "pos",
    "supermarket",
    "electron",
    "react",
    "billing",
    "anatha-stores"
  ],
  "author": "Anatha Stores",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.20.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "fuse.js": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.446.0",
    "morgan": "^1.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.12",
    "vite": "^5.4.7",
    "wait-on": "^8.0.1"
  }
}
