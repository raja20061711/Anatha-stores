generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Note: SQLite does not support enums; values are stored as String
// RoleType values: ADMIN, MANAGER, CASHIER
// PurchaseStatus values: DRAFT, RECEIVED, CANCELLED
// PaymentMethod values: CASH, UPI, CARD, SPLIT
// StockMovementType values: SALE, PURCHASE, RETURN, DAMAGE, ADJUSTMENT
// LoyaltyTxType values: EARN, REDEEM, ADJUSTMENT, REVERSAL

model User {
  id           Int              @id @default(autoincrement())
  fullName     String
  username     String           @unique
  passwordHash String
  role         String           @default("CASHIER") // ADMIN, MANAGER, CASHIER
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sales            Sale[]
  purchases        Purchase[]
  stockMovements   StockMovement[]
  auditLogs        AuditLog[]
  priceHistories   PriceHistory[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id              Int            @id @default(autoincrement())
  name            String
  tamilName       String?
  brand           String?
  barcode         String?        @unique
  sku             String?
  categoryId      Int?
  measurementType String         @default("PCS") // PCS, KG, G, L, ML, PACK, BOX
  baseUnit        String         @default("pcs") // pcs, kg, g, l, ml, pack, box
  unit            String         @default("pcs") // legacy unit compatibility
  purchaseCost    Decimal        @default(0.00)
  sellingPrice    Decimal        @default(0.00)
  pricePerKg      Decimal?
  packSize        String?
  currentStock    Decimal        @default(0.000)
  minStock        Decimal        @default(5.000)
  imageUrl        String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id])
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  priceHistories PriceHistory[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model PriceHistory {
  id          Int      @id @default(autoincrement())
  productId   Int
  oldPrice    Decimal
  newPrice    Decimal
  changedById Int
  reason      String?
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy   User     @relation(fields: [changedById], references: [id])

  @@index([productId])
  @@map("price_history")
}

model Customer {
  id             Int                  @id @default(autoincrement())
  name           String
  phone          String               @unique
  address        String?
  loyaltyBalance Decimal              @default(0.00)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  sales          Sale[]
  loyaltyTxs     LoyaltyTransaction[]

  @@index([phone])
  @@map("customers")
}

model Supplier {
  id            Int        @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String
  email         String?
  address       String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  purchases     Purchase[]

  @@map("suppliers")
}

model Purchase {
  id             Int            @id @default(autoincrement())
  invoiceNumber  String         @unique
  supplierId     Int
  purchaseDate   DateTime       @default(now())
  totalAmount    Decimal        @default(0.00)
  paidAmount     Decimal        @default(0.00)
  balanceAmount  Decimal        @default(0.00)
  status         String         @default("DRAFT") // DRAFT, RECEIVED, CANCELLED
  receivedById   Int?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  receivedBy     User?          @relation(fields: [receivedById], references: [id])
  items          PurchaseItem[]

  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id           Int      @id @default(autoincrement())
  purchaseId   Int
  productId    Int
  quantity     Decimal
  purchaseCost Decimal
  lineTotal    Decimal

  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id             Int           @id @default(autoincrement())
  billNumber     String        @unique
  cashierId      Int
  customerId     Int?
  subtotal       Decimal
  discountTotal  Decimal       @default(0.00)
  taxTotal       Decimal       @default(0.00)
  grandTotal     Decimal
  paymentMethod  String        @default("CASH") // CASH, UPI, CARD, SPLIT
  amountReceived Decimal       @default(0.00)
  changeAmount   Decimal       @default(0.00)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  cashier        User          @relation(fields: [cashierId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  items          SaleItem[]
  payments       Payment[]
  loyaltyTxs     LoyaltyTransaction[]

  @@index([billNumber])
  @@index([cashierId])
  @@index([customerId])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id                Int      @id @default(autoincrement())
  saleId            Int
  productId         Int
  productName       String
  quantity          Decimal
  measurementType   String?  @default("PCS")
  unit              String?  @default("pcs")
  selectedQuantity  Decimal?
  selectedUnit      String?
  canonicalQuantity Decimal?
  canonicalUnit     String?
  priceBasis        String?
  unitPrice         Decimal?
  originalRate      Decimal
  billedRate        Decimal
  isOverridden      Boolean  @default(false)
  overrideReason    String?
  lineTotal         Decimal

  sale              Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  saleId        Int
  paymentMethod String  // CASH, UPI, CARD, SPLIT
  amount        Decimal
  reference     String?
  createdAt     DateTime      @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payments")
}

model StockMovement {
  id             Int               @id @default(autoincrement())
  productId      Int
  type           String            // SALE, PURCHASE, RETURN, DAMAGE, ADJUSTMENT
  quantityChange Decimal
  previousStock  Decimal
  newStock       Decimal
  reason         String?
  userId         Int
  referenceId    String? // e.g., Bill Number or Purchase Invoice Number
  createdAt      DateTime          @default(now())

  product        Product           @relation(fields: [productId], references: [id])
  user           User              @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

model LoyaltySettings {
  id                     Int      @id @default(1)
  isEnabled              Boolean  @default(true)
  minPurchaseAmount      Decimal  @default(100.00) // e.g. min 100 INR to earn
  pointsPerAmount        Decimal  @default(5.00) // e.g. 5 points per 100
  pointsRedemptionValue  Decimal  @default(1.00) // 1 point = 1 INR
  minRedemptionPoints    Decimal  @default(10.00)
  updatedAt              DateTime @updatedAt

  @@map("loyalty_settings")
}

model LoyaltyTransaction {
  id           Int           @id @default(autoincrement())
  customerId   Int
  saleId       Int?
  type         String        // EARN, REDEEM, ADJUSTMENT, REVERSAL
  points       Decimal
  balanceAfter Decimal
  notes        String?
  createdAt    DateTime      @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id])
  sale         Sale?         @relation(fields: [saleId], references: [id])

  @@index([customerId])
  @@map("loyalty_transactions")
}

model HeldBill {
  id           Int      @id @default(autoincrement())
  billData     String   // JSON encoded held bill items, customer & notes
  customerName String?
  totalAmount  Decimal  @default(0.00)
  cashierId    Int
  heldAt       DateTime @default(now())

  @@map("held_bills")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ApplicationSettings {
  id                         Int      @id @default(1)
  shopName                   String   @default("ANANTHA STORE")
  shopLogo                   String?  // Base64 encoded logo
  address                    String   @default("Main Bazaar, Supermarket Road")
  phone                      String   @default("+91 98765 43210")
  currency                   String   @default("₹")
  receiptSize                String   @default("80mm") // 58mm, 80mm, A4
  taxPercentage              Decimal  @default(0.00)
  enableCashierPriceOverride Boolean  @default(true)
  requireOverrideReason      Boolean  @default(true)
  minAllowedPricePercentage  Decimal  @default(50.00) // Cannot sell below 50% of default rate without authorization
  zeroPriceAllowed           Boolean  @default(false)
  updatedAt                  DateTime @updatedAt

  @@map("application_settings")
}
